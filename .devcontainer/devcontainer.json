// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go .
{
	"name": "Go",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/go:2-1.26-trixie",
	// Enable cgroup v2 access for memory limit enforcement in test harness
	"runArgs": [
		"--privileged",
		"--cgroupns=host"
	],
	// Mount storage secrets from host for object store access
	"mounts": [
		"source=${localWorkspaceFolder}/.config/thanos,target=/home/vscode/.config/thanos,type=bind,consistency=cached"
	],
	"features": {
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainer-config/features/dot-config:4": {},
		"ghcr.io/sliekens/devcontainer-features/claude:1": {},
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.13"
		}
	},
	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": ".devcontainer/post-create.sh"
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
